include LICENSE README.md pyproject.toml
include AGENTS.md PROTOCOL.md SECURITY.md ENTERPRISE.md CONTRIBUTING.md CLAUDE.md
include llms.txt llms-full.txt ai.txt
include skills/claimidx/SKILL.md
include schema/claim.v1.json
include server.json
include .well-known/agent-card.json
include .well-known/agent.json
include .well-known/mcp.json
include .well-known/mcp/server-card.json
include .well-known/api-catalog
include .well-known/security.txt
include .well-known/agent-skills/index.json
graft src/claimidx
recursive-include tests *.py
exclude tests/test_social_directed.py
exclude tests/test_worker_fp.py
exclude tests/test_worker_oauth.py
exclude tests/test_worker_stripe.py
exclude tests/test_stripe_hook.py
exclude tests/worker_fp_probe.mjs
exclude tests/worker_oauth_probe.mjs
exclude tests/worker_stripe_probe.mjs
exclude scripts/social_reply.py
exclude src/claimidx/stripe_hook.py
prune INTERNAL
exclude INTERNAL/BOTS.md
exclude INTERNAL/ops
exclude scripts/claimidx_ops.ps1
exclude scripts/claimidx_home.ps1
global-exclude *.pyc
global-exclude __pycache__
