{
  "hooks": {
    "PostToolUseFailure": [
      { "matcher": "Bash|run_terminal_command", "hooks": [ { "type": "command", "command": "python -m claimidx hook", "timeout": 15 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Bash|run_terminal_command", "hooks": [ { "type": "command", "command": "python -m claimidx hook", "timeout": 15 } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "python -m claimidx hook", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python -m claimidx hook", "timeout": 15 } ] }
    ]
  }
}
