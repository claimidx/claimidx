#!/bin/sh
# Claimidx pre-push gate: sanitize the tracked tree, docs in sync, ruff + mypy + pytest, live MCP handshake.
# Install once per clone: python scripts/gate.py install-hooks
PY=$(command -v python || command -v python3)
cd "$(git rev-parse --show-toplevel)" || exit 1
exec "$PY" scripts/gate.py pre-push
